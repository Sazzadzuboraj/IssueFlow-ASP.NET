@model Project
@{
    ViewData["Title"] = "Project Details";
    string RoleLabel(string? role) => role switch
    {
        "ProjectManager" => "Project Leader",
        "QATester" => "QA Tester",
        _ => role ?? "Member"
    };
}

<div class="card p-4 mb-4 border-0 shadow-sm">
    <div class="d-flex justify-content-between flex-wrap gap-2">
        <div>
            <h3 class="mb-1">@Model.Name</h3>
            <p class="text-muted mb-2">@Model.Description</p>
            <p class="small mb-0">
                <strong>Created by:</strong> @(Model.CreatedBy?.FullName ?? "—")
                on @Model.CreatedDate.ToString("dd MMM yyyy")
            </p>
            @if (!string.IsNullOrEmpty(Model.FolderPath))
            {
                <p class="small mb-0 mt-1">
                    <strong>Source folder:</strong>
                    <code>wwwroot/uploads/projects/@Model.FolderPath/</code>
                </p>
            }
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-start">
            <a asp-controller="Board" asp-action="Project" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-kanban me-1"></i> Board
            </a>
            <a asp-action="Members" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-people me-1"></i> Team
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
            }
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                <span>Team</span>
                @if (User.IsInRole("Admin") || User.IsInRole("ProjectManager"))
                {
                    <a class="btn btn-sm btn-outline-primary" asp-action="Members" asp-route-id="@Model.Id">Manage team</a>
                }
            </div>
            <ul class="list-group list-group-flush">
                @if (Model.Members != null && Model.Members.Any())
                {
                    foreach (var m in Model.Members.OrderBy(x => x.Role != "ProjectManager").ThenBy(x => x.User?.FullName))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">@(m.User?.FullName ?? m.UserId)</div>
                                <div class="small text-muted">@m.User?.Email</div>
                            </div>
                            <span class="badge @(m.Role == "ProjectManager" ? "bg-warning text-dark" : "bg-primary")">
                                @RoleLabel(m.Role)
                            </span>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-muted">No team members yet.</li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                <span>Issues</span>
                <a class="btn btn-sm btn-outline-secondary" asp-controller="Board" asp-action="Project" asp-route-id="@Model.Id">Open board</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Priority</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Issues != null && Model.Issues.Any())
                        {
                            foreach (var issue in Model.Issues.OrderByDescending(i => i.CreatedDate).Take(20))
                            {
                                <tr>
                                    <td><a asp-controller="Issue" asp-action="Details" asp-route-id="@issue.Id">@issue.Title</a></td>
                                    <td><span class="badge bg-secondary">@issue.Status</span></td>
                                    <td>@issue.Priority</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">No issues yet. Create an issue, then track it on the Board.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
