@model IEnumerable<IssueFlow.Models.Bug>
@foreach (var item in Model)
{
    <tr>
        <td>
            <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-decoration-none">@item.Title</a>
        </td>
        <td>@item.Project?.Name</td>
        <td><span class="badge bg-secondary">@item.Status</span></td>
        <td>
            @{
                var pClass = item.Priority switch
                {
                    "Critical" => "bg-danger",
                    "High" => "bg-warning text-dark",
                    "Medium" => "bg-info text-dark",
                    _ => "bg-light text-dark"
                };
            }
            <span class="badge @pClass">@item.Priority</span>
        </td>
        <td class="small text-muted">@item.ReportedBy?.FullName</td>
        <td class="small text-muted">@item.AssignedDeveloper?.FullName</td>
        <td>
            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View</a>
        </td>
    </tr>
}
@if (!Model.Any())
{
    <tr>
        <td colspan="7" class="text-center text-muted py-4">No bugs match your filters.</td>
    </tr>
}
