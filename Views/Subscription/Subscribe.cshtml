@{
    ViewData["Title"] = "Subscribe";
    var plans = ViewBag.Plans as Dictionary<string, (decimal Amount, int Days)>;
}

<div class="mb-3">
    <h5>Choose a plan</h5>
    <p class="text-muted small">Payment is processed securely via <strong>SSLCommerz</strong>. Subscription activates only after successful payment.</p>
</div>

<div class="row g-3">
@if (plans != null)
{
    @foreach (var plan in plans)
    {
        <div class="col-md-4">
            <div class="card text-center h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <h4 class="card-title">@plan.Key</h4>
                    <h2 class="my-3">৳@plan.Value.Amount</h2>
                    <p class="text-muted">@plan.Value.Days days access</p>
                    <ul class="list-unstyled text-start small flex-grow-1">
                        <li>✓ Projects &amp; Issues</li>
                        <li>✓ Bug tracking</li>
                        <li>✓ Team dashboards</li>
                        <li>✓ Priority support</li>
                    </ul>
                    <form asp-controller="Payment" asp-action="Initiate" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="plan" value="@plan.Key" />
                        <button type="submit" class="btn btn-primary w-100">
                            Pay with SSLCommerz
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
}
</div>
