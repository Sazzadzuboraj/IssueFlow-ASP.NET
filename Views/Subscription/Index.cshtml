@model IEnumerable<Subscription>
@{
    ViewData["Title"] = "My Subscription";
    var active = ViewBag.ActiveSubscription as Subscription;
}

@if (active != null)
{
    <div class="alert alert-success">
        <h5>Active Plan: @active.Plan</h5>
        <p class="mb-0">
            Valid from @active.StartDate.ToString("dd MMM yyyy") to @active.EndDate.ToString("dd MMM yyyy")
            | Amount: ৳@active.Amount
        </p>
    </div>
}
else
{
    <div class="alert alert-warning">
        <strong>No active subscription.</strong>
        You can browse projects and issues. Creating projects or issues requires a paid plan.
        <a asp-action="Subscribe" class="btn btn-sm btn-primary ms-2">Subscribe Now</a>
    </div>
}

<div class="d-flex justify-content-between mb-3">
    <h5>Subscription History</h5>
    <a asp-action="Subscribe" class="btn btn-primary">Buy / Renew Plan</a>
</div>

<div class="card">
    <table class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Plan</th>
                <th>Start</th>
                <th>End</th>
                <th>Amount</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Plan</td>
                    <td>@s.StartDate.ToString("dd MMM yyyy")</td>
                    <td>@s.EndDate.ToString("dd MMM yyyy")</td>
                    <td>৳@s.Amount</td>
                    <td>
                        @if (s.IsActive && s.EndDate >= DateTime.UtcNow)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Expired</span>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-3">No subscription history.</td></tr>
            }
        </tbody>
    </table>
</div>
