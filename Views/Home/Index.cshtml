@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card card-stat bg-primary text-white">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 opacity-75">Total Projects</h6>
                <h2 class="card-title mb-0">@Model.TotalProjects</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stat bg-info text-white">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 opacity-75">Total Issues</h6>
                <h2 class="card-title mb-0">@Model.TotalIssues</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stat bg-warning text-dark">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 opacity-75">Open Issues</h6>
                <h2 class="card-title mb-0">@Model.OpenIssues</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stat bg-success text-white">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 opacity-75">Closed Issues</h6>
                <h2 class="card-title mb-0">@Model.ClosedIssues</h2>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card card-stat">
            <div class="card-body">
                <h6>In Progress</h6>
                <h3>@Model.InProgressIssues</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card card-stat">
            <div class="card-body">
                <h6>Resolved</h6>
                <h3>@Model.ResolvedIssues</h3>
            </div>
        </div>
    </div>
</div>

@if (Model.ActiveSubscription != null)
{
    <div class="alert alert-info">
        <strong>Active Plan:</strong> @Model.ActiveSubscription.Plan 
        (Expires: @Model.ActiveSubscription.EndDate.ToString("dd MMM yyyy"))
    </div>
}
else
{
    <div class="alert alert-warning">
        No active subscription. <a asp-controller="Subscription" asp-action="Subscribe">Subscribe now</a>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between">
        <h5 class="mb-0">Recent Issues</h5>
        <a asp-controller="Issue" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Project</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var issue in Model.RecentIssues)
                {
                    <tr>
                        <td><a asp-controller="Issue" asp-action="Details" asp-route-id="@issue.Id">@issue.Title</a></td>
                        <td>@issue.Project?.Name</td>
                        <td>
                            <span class="badge @(issue.Status switch {
                                "Open" => "bg-warning text-dark",
                                "In Progress" => "bg-info",
                                "Resolved" => "bg-primary",
                                "Closed" => "bg-success",
                                _ => "bg-secondary"
                            })">@issue.Status</span>
                        </td>
                        <td>@issue.Priority</td>
                        <td>@issue.CreatedDate.ToString("dd MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
