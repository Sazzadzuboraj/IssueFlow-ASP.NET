<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IssueFlow</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Bootstrap CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
            body {
                background-color: #f4f6f9;
            }

            .sidebar {
                min-height: 100vh;
                background: #1e293b;
                color: #fff;
            }

                .sidebar .nav-link {
                    color: #cbd5e1;
                    border-radius: 8px;
                    margin: 2px 0;
                }

                    .sidebar .nav-link:hover, .sidebar .nav-link.active {
                        background: #334155;
                        color: #fff;
                    }

            .card-stat {
                border: none;
                border-radius: 12px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            }

            .navbar-brand {
                font-weight: 700;
                letter-spacing: 0.5px;
            }

            .toast-container {
                z-index: 1090;
            }

            a[href*="/Issue/Details"],
            a[href*="/Bug/Details"],
            .issue-link {
                color: #2563eb !important; /* Blue Colour */
                font-weight: 600 !important;
                text-decoration: none !important;
            }

                a[href*="/Issue/Details"]:hover,
                a[href*="/Bug/Details"]:hover,
                .issue-link:hover {
                    color: #1d4ed8 !important;
                    text-decoration: underline !important;
                }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- Sidebar -->
                <div class="col-md-2 sidebar p-3">
                    <h4 class="mb-4 text-center">🐛 IssueFlow</h4>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Project" ? "active" : "")" asp-controller="Project" asp-action="Index">
                                <i class="bi bi-folder me-2"></i> Projects
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Issue" ? "active" : "")" asp-controller="Issue" asp-action="Index">
                                <i class="bi bi-list-task me-2"></i> Issues
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Bug" ? "active" : "")" asp-controller="Bug" asp-action="Index">
                                <i class="bi bi-bug me-2"></i> Bugs
                            </a>
                        </li>
                        @if (User.IsInRole("Developer") || User.IsInRole("QATester") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AssignmentRequest" ? "active" : "")" asp-controller="AssignmentRequest" asp-action="Available">
                                    <i class="bi bi-hand-index me-2"></i> Request work
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("ProjectManager") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="AssignmentRequest" asp-action="Pending">
                                    <i class="bi bi-inbox me-2"></i> Work requests
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "User" ? "active" : "")" asp-controller="User" asp-action="Index">
                                    <i class="bi bi-people me-2"></i> Users
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Subscription" asp-action="All">
                                    <i class="bi bi-card-list me-2"></i> All Subscriptions
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Subscription" ? "active" : "")" asp-controller="Subscription" asp-action="Index">
                                <i class="bi bi-credit-card me-2"></i> My Subscription
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["Action"]?.ToString() == "MyProfile" ? "active" : "")" asp-controller="Account" asp-action="MyProfile">
                                <i class="bi bi-person-circle me-2"></i> My Profile
                            </a>
                        </li>
                        <li class="nav-item mt-4">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="nav-link btn btn-link text-start w-100 text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

                <div class="col-md-10 p-4 d-flex flex-column min-vh-100">
                    <!-- Top bar -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0">@ViewData["Title"]</h4>
                        <div class="d-flex align-items-center gap-3">
                            @await Component.InvokeAsync("NotificationBell")
                            <span class="text-muted">@User.Identity?.Name</span>
                            @if (User.IsInRole("Admin"))
                            {
                                <span class="badge bg-danger">Admin</span>
                            }
                            else if (User.IsInRole("ProjectManager"))
                            {
                                <span class="badge bg-primary">PM</span>
                            }
                            else if (User.IsInRole("Developer"))
                            {
                                <span class="badge bg-success">Developer</span>
                            }
                            else if (User.IsInRole("QATester"))
                            {
                                <span class="badge bg-warning text-dark">QA</span>
                            }
                        </div>
                    </div>

                    <!-- Toast-style alerts (auto-dismiss) -->
                    <div class="toast-container position-fixed top-0 end-0 p-3">
                        @if (TempData["Success"] != null)
                        {
                            <div class="toast show align-items-center text-bg-success border-0" role="alert" data-bs-autohide="true" data-bs-delay="4000">
                                <div class="d-flex">
                                    <div class="toast-body"><i class="bi bi-check-circle me-1"></i> @TempData["Success"]</div>
                                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                                </div>
                            </div>
                        }
                        @if (TempData["Error"] != null)
                        {
                            <div class="toast show align-items-center text-bg-danger border-0" role="alert" data-bs-autohide="true" data-bs-delay="6000">
                                <div class="d-flex">
                                    <div class="toast-body"><i class="bi bi-exclamation-triangle me-1"></i> @TempData["Error"]</div>
                                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Main Content Body -->
                    <div class="flex-grow-1">
                        @RenderBody()
                    </div>

                    <!-- Logged-in User Footer 
                    <footer class="text-center py-3 border-t border-gray-200 mt-6 text-gray-500 text-sm">
                        <p class="mb-0">&copy; @DateTime.Now.Year - <strong class="text-gray-700">SaZZad Zubo_raj</strong>. All rights reserved.</p>
                    </footer>   -->
                </div>
            }
            else
            {
                <div class="col-12 d-flex flex-column min-vh-100 p-0">
                    <!-- Main Content Body (Logged out) -->
                    <div class="flex-grow-1">
                        @RenderBody()
                    </div>

                    <!-- Logged-out User Footer 
                    <footer class="text-center py-3 border-t border-gray-200 bg-white text-gray-500 text-sm">
                        <p class="mb-0">&copy; @DateTime.Now.Year - <strong class="text-gray-700">SaZZad Zubo_raj</strong>. All rights reserved.</p>
                    </footer>   -->
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            // Auto-show & dismiss toasts
            document.querySelectorAll('.toast').forEach(el => {
                const t = new bootstrap.Toast(el);
                t.show();
            });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>