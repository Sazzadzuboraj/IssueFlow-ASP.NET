@model List<IssueFlow.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-bell me-2"></i>Notifications</h5>
    <form asp-action="MarkAllRead" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-sm btn-outline-secondary">Mark all as read</button>
    </form>
</div>

<div class="card border-0 shadow-sm">
    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-bell-slash display-6 d-block mb-2"></i>
            No notifications yet.
        </div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var n in Model)
            {
                <li class="list-group-item @(n.IsRead ? "" : "bg-light")">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-semibold">
                                @if (!string.IsNullOrEmpty(n.LinkUrl))
                                {
                                    <a href="@n.LinkUrl" class="text-decoration-none">@n.Title</a>
                                }
                                else
                                {
                                    @n.Title
                                }
                                @if (!n.IsRead)
                                {
                                    <span class="badge bg-primary ms-1">New</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(n.Message))
                            {
                                <div class="text-muted small">@n.Message</div>
                            }
                            <div class="text-muted small">@n.CreatedDate.ToLocalTime().ToString("dd MMM yyyy HH:mm") · @n.Type</div>
                        </div>
                        @if (!n.IsRead)
                        {
                            <form asp-action="MarkRead" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@n.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark read</button>
                            </form>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>
